# App Settings
APP_NAME="Healthcare RFP Analyzer"
APP_VERSION="1.0.0"
DEBUG=False

# Database Configuration
DATABASE_URL="postgresql://rfp_user:rfp_password@localhost:5432/rfp_analyzer"

# LLM Configuration
LLM_API_KEY="your-api-key-here"
LLM_MODEL="gpt-4"
LLM_PROVIDER="openai"
LLM_BASE_URL=""
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Vector Database Configuration
VECTOR_DB_PATH="./data/chromadb"

# Upload Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=52428800

# Embedding Configuration
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# Logging Configuration
LOG_LEVEL="INFO"
